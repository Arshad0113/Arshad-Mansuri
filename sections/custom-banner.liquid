<div class="custom-banner-wrapper">
  <div class="custom-banner" style="background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');">
    <div class="banner-content">
      <h1 class="banner-title">{{ section.settings.heading }}</h1>
      <p class="banner-text">{{ section.settings.subtext }}</p>
      
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="banner-button">
          {{ section.settings.btn_text }} <span class="arrow">&#8594;</span>
        </a>
      {% endif %}
    </div>
  </div>
  
  {% if section.settings.bottom_text != blank %}
  <div class="banner-bottom-bar">
    <p>{{ section.settings.bottom_text }}</p>
  </div>
  {% endif %}
</div>

<style>
  .custom-banner-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .custom-banner {
    width: 100%;
    min-height: 500px;
    background-color: #ffffff;
    background-position: right center; /* Align image to the right */
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 50px 8%;
  }

  .banner-content {
    max-width: 450px; /* Constrain width to keep text aligned to the left */
    text-align: left;
  }

  .banner-title {
    font-size: 3.5rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: #000;
    line-height: 1.1;
  }

  .banner-text {
    font-size: 1rem;
    color: #333;
    line-height: 1.5;
    margin-bottom: 30px;
  }

  /* Button Styling */
  .banner-button {
    display: inline-flex;
    align-items: center;
    background-color: #000;
    color: #fff;
    padding: 15px 35px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .banner-button .arrow {
    margin-left: 10px;
    transition: transform 0.3s ease;
  }

  /* Hover Animation for Button */
  .banner-button:hover {
    background-color: #F9E736; /* Accent yellow color */
    color: #000;
  }

  .banner-button:hover .arrow {
    transform: translateX(5px); /* Move arrow slightly to the right */
  }

  /* Bottom Notification Bar */
  .banner-bottom-bar {
    background-color: #f5f5f5;
    text-align: center;
    padding: 15px;
    font-size: 0.85rem;
    letter-spacing: 1px;
    color: #333;
    text-transform: uppercase;
  }

  /* Responsive Design for Mobile Devices */
  @media screen and (max-width: 768px) {
    .custom-banner {
      flex-direction: column;
      justify-content: flex-start;
      padding: 40px 20px;
      background-position: bottom center; /* Position image at the bottom */
      background-size: contain;
      min-height: 600px;
    }
    .banner-content {
      text-align: center;
      margin-bottom: auto;
    }
    .banner-title {
      font-size: 2.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Bar Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}