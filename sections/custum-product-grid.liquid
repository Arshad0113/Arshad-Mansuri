{% style %}
  /* --- Section & Grid Layout --- */
  .tisso-wild-section {
    padding: 60px 8%;
    background-color: #f4f4f4;
    font-family: 'Instrument Sans', sans-serif;
  }

  .wild-header {
    text-align: left;
    margin-bottom: 30px;
  }

  .wild-header h2 {
    font-size: 32px;
    font-weight: 400;
    color: #121212;
    margin: 0;
    font-family: serif;
  }

  .wild-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .wild-grid-item {
    position: relative;
    background-color: #fff;
    width: 100%;
    padding-top: 100%; /* Creates a perfect square */
    overflow: hidden;
  }

  .wild-grid-item > img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 1;
  }

  .btn-open-modal {
    position: absolute; bottom: 20px; right: 20px;
    width: 35px; height: 35px; background-color: #fff; color: #000;
    border: none; border-radius: 50%; font-size: 20px; font-weight: 300;
    cursor: pointer; z-index: 2; display: flex; justify-content: center; align-items: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: transform 0.2s ease;
  }
  .btn-open-modal:hover { transform: scale(1.1); }

  /* --- In-Place Quick View Modal (NO SCROLL DESIGN) --- */
  .wild-quick-view {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background-color: #fff; z-index: 5; display: none;
    flex-direction: column; padding: 15px; box-sizing: border-box;
  }

  .btn-close-modal {
    position: absolute; top: 10px; right: 10px; background: none; border: none;
    font-size: 16px; cursor: pointer; color: #000; z-index: 6; padding: 5px;
  }

  /* Top Area: Image + Info */
  .modal-top-row {
    display: flex; gap: 12px; height: 35%; margin-bottom: 12px;
  }

  .modal-thumbnail {
    width: 45%; height: 100%; object-fit: cover;
  }

  .modal-info {
    width: 55%; display: flex; flex-direction: column; justify-content: flex-start;
  }

  .modal-title { font-size: 13px; font-weight: normal; color: #333; margin: 0 0 4px; }
  .modal-price { font-size: 14px; font-weight: 600; color: #000; margin: 0 0 4px; }
  
  .modal-desc {
    font-size: 10px; color: #666; line-height: 1.3; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Form Elements */
  .modal-form {
    display: flex; flex-direction: column; flex: 1; justify-content: space-between;
  }

  .option-label { font-size: 11px; margin-bottom: 5px; color: #333; }

  /* Color Buttons (Clickable Fix) */
  .color-boxes {
    display: flex; border: 1px solid #ccc; height: 32px;
  }

  .color-box {
    flex: 1; display: flex; align-items: center; justify-content: center;
    font-size: 12px; cursor: pointer; background: #fff; color: #000; transition: 0.2s;
  }

  .color-box:first-child { border-right: 1px solid #ccc; }
  
  /* Active Class for selected color (Figma match) */
  .color-box.active { background: #000; color: #fff; font-weight: 600; }

  /* Size Dropdown (Figma Match) */
  .size-select-wrapper {
    position: relative; height: 35px; border: 1px solid #ccc; background: #fff;
  }

  .size-select {
    width: 100%; height: 100%; padding: 0 10px; font-size: 12px; border: none;
    background: transparent; appearance: none; outline: none; cursor: pointer; color: #000;
  }

  .select-chevron {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    font-size: 12px; pointer-events: none; color: #000;
  }

  /* Cart Button */
  .btn-modal-cart {
    width: 100%; height: 42px; background: #000; color: #fff; border: none;
    font-size: 11px; font-weight: 600; cursor: pointer; display: flex; 
    align-items: center; justify-content: center; letter-spacing: 0.5px;
    text-transform: uppercase; transition: 0.3s;
  }
  .btn-modal-cart:hover { background: #333; }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .wild-grid { grid-template-columns: repeat(2, 1fr); }
    .tisso-wild-section { padding: 40px 20px; }
  }
  @media screen and (max-width: 480px) {
    .wild-grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="tisso-wild-section">
  <div class="wild-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="wild-grid">
    {% assign selected_collection = section.settings.collection %}
    
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% for product in selected_collection.products limit: 6 %}
        
        <div class="wild-grid-item">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" loading="lazy">
          
          <button class="btn-open-modal" onclick="openModal('modal-{{ product.id }}')">+</button>

          <div class="wild-quick-view" id="modal-{{ product.id }}">
            <button class="btn-close-modal" type="button" onclick="closeModal('modal-{{ product.id }}')">&#10005;</button>
            
            <div class="modal-top-row">
              <img src="{{ product.featured_image | image_url: width: 150 }}" alt="{{ product.title | escape }}" class="modal-thumbnail" width="150" height="200" loading="lazy">
              <div class="modal-info">
                <h3 class="modal-title">{{ product.title }}</h3>
                <p class="modal-price">{{ product.price | money }}</p>
                <div class="modal-desc">{{ product.description | strip_html | truncatewords: 12 }}</div>
              </div>
            </div>

            <form method="post" action="{{ routes.cart_add_url }}" class="modal-form">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}" />

              <div>
                <div class="option-label">Color</div>
                <div class="color-boxes" id="color-box-{{ product.id }}">
                  <div class="color-box active" onclick="selectColor(this, '{{ product.id }}')">White</div>
                  <div class="color-box" onclick="selectColor(this, '{{ product.id }}')">Black</div>
                </div>
              </div>

              <div>
                <div class="option-label">Size</div>
                <div class="size-select-wrapper">
                  <select class="size-select">
                    <option>Choose your size</option>
                    <option>XS</option>
                    <option>S</option>
                    <option>M</option>
                    <option>L</option>
                    <option>XL</option>
                  </select>
                  <span class="select-chevron">&#8964;</span> </div>
              </div>

              <button type="submit" class="btn-modal-cart">
                ADD TO CART <span style="margin-left: 8px;">&rarr;</span>
              </button>
            </form>
            
          </div>
        </div>

      {% endfor %}
    {% else %}
      <p>Please select a collection in the theme settings to display products.</p>
    {% endif %}
  </div>
</div>

<script>
  function openModal(modalId) {
    document.getElementById(modalId).style.display = 'flex';
  }

  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }

  // Color Box Click Logic
  function selectColor(element, productId) {
    // 1. Us product ke dono boxes dhoondho
    let container = document.getElementById('color-box-' + productId);
    let boxes = container.querySelectorAll('.color-box');
    
    // 2. Sabme se 'active' class hata do (safed kar do)
    boxes.forEach(box => box.classList.remove('active'));
    
    // 3. Jis par click hua hai, us par 'active' class laga do (kaala kar do)
    element.classList.add('active');
  }
</script>

{% schema %}
{
  "name": "Tisso Wild Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Tisso Wild Grid"
    }
  ]
}
{% endschema %}