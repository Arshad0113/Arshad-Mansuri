{% style %}
  /* --- Section & Grid Layout --- */
  .tisso-wild-section {
    padding: 60px 8%;
    background-color: #f4f4f4; /* Light grey background from Figma */
    font-family: 'Instrument Sans', sans-serif;
  }

  .wild-header {
    text-align: left;
    margin-bottom: 30px;
  }

  .wild-header h2 {
    font-size: 32px;
    font-weight: 400;
    color: #121212;
    margin: 0;
    font-family: serif; /* Figma heading has a slightly classic serif look */
  }

  .wild-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px; /* Small gap like Figma */
  }

  /* --- Grid Item & Image --- */
  .wild-grid-item {
    position: relative;
    background-color: #fff;
    width: 100%;
    padding-top: 100%; /* Creates a perfect square */
    overflow: hidden;
  }

  .wild-grid-item > img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Plus (+) Button on Image */
  .btn-open-modal {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 35px;
    height: 35px;
    background-color: #fff;
    color: #000;
    border: none;
    border-radius: 50%;
    font-size: 20px;
    font-weight: 300;
    cursor: pointer;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.2s ease;
  }

  .btn-open-modal:hover {
    transform: scale(1.1);
  }

  /* --- In-Place Quick View Modal (The Card Overlay) --- */
  .wild-quick-view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #fff;
    z-index: 5;
    display: none; /* Hidden by default */
    flex-direction: column;
    padding: 20px;
    box-sizing: border-box;
    overflow-y: auto;
  }

  /* Close (x) Button */
  .btn-close-modal {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    color: #000;
    z-index: 6;
  }

  /* Modal Content Styling (Figma Match) */
  .modal-top-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }

  .modal-thumbnail {
    width: 80px;
    height: 100px;
    object-fit: cover;
  }

  .modal-title-price {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .modal-title {
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin: 0 0 5px 0;
  }

  .modal-price {
    font-size: 14px;
    font-weight: 600;
    color: #000;
    margin: 0;
  }

  .modal-desc {
    font-size: 11px;
    color: #666;
    line-height: 1.4;
    margin-bottom: 15px;
  }

  /* Form Elements (Color & Size) */
  .modal-form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .option-label {
    font-size: 12px;
    margin-bottom: 5px;
    color: #000;
  }

  .color-boxes {
    display: flex;
    border: 1px solid #ddd;
    margin-bottom: 15px;
  }

  .color-box {
    flex: 1;
    text-align: center;
    padding: 8px 0;
    font-size: 12px;
    border-right: 1px solid #ddd;
    cursor: pointer;
  }

  .color-box:last-child {
    border-right: none;
  }

  .size-select {
    width: 100%;
    padding: 10px;
    font-size: 12px;
    border: 1px solid #ddd;
    margin-bottom: auto; /* Pushes button to bottom */
    background: #fff;
    outline: none;
  }

  /* Add to Cart Button */
  .btn-modal-cart {
    width: 100%;
    background-color: #000;
    color: #fff;
    border: none;
    padding: 15px 0;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background 0.3s;
  }

  .btn-modal-cart span {
    margin-left: 10px;
  }

  .btn-modal-cart:hover {
    background-color: #333;
  }

  /* --- Mobile Responsive --- */
  @media screen and (max-width: 768px) {
    .wild-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tisso-wild-section {
      padding: 40px 20px;
    }
  }
  @media screen and (max-width: 480px) {
    .wild-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="tisso-wild-section">
  <div class="wild-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="wild-grid">
    {% assign selected_collection = section.settings.collection %}
    
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% for product in selected_collection.products limit: 6 %}
        
        <div class="wild-grid-item">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" loading="lazy">
          
          <button class="btn-open-modal" onclick="openModal('modal-{{ product.id }}')">+</button>

          <div class="wild-quick-view" id="modal-{{ product.id }}">
            <button class="btn-close-modal" onclick="closeModal('modal-{{ product.id }}')">&#10005;</button>
            
            <div class="modal-top-row">
              <img src="{{ product.featured_image | image_url: width: 150 }}" alt="{{ product.title | escape }}" class="modal-thumbnail" width="150" height="200" loading="lazy">
              <div class="modal-title-price">
                <h3 class="modal-title">{{ product.title }}</h3>
                <p class="modal-price">{{ product.price | money }}</p>
              </div>
            </div>

            <div class="modal-desc">
              {{ product.description | strip_html | truncatewords: 15 }}
            </div>

            <form method="post" action="{{ routes.cart_add_url }}" class="modal-form">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}" />

              <div class="option-label">Color</div>
              <div class="color-boxes">
                <div class="color-box" style="font-weight: 600; border-right: 2px solid #000;">White</div>
                <div class="color-box">Black</div>
              </div>

              <div class="option-label">Size</div>
              <select class="size-select">
                <option>Choose your size</option>
                <option>Small</option>
                <option>Medium</option>
                <option>Large</option>
              </select>

              <button type="submit" class="btn-modal-cart">
                ADD TO CART <span>&rarr;</span>
              </button>
            </form>
            
          </div>
        </div>

      {% endfor %}
    {% else %}
      <p>Please select a collection in the theme settings to display products.</p>
    {% endif %}
  </div>
</div>

<script>
  function openModal(modalId) {
    document.getElementById(modalId).style.display = 'flex';
  }

  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }
</script>

{% schema %}
{
  "name": "Tisso Wild Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Tisso Wild Grid"
    }
  ]
}
{% endschema %}